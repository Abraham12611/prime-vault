# Prime Vault Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ==========================================
# REQUIRED FOR DEPLOYMENT
# ==========================================

# Your wallet private key (with 0x prefix)
# Used for deploying contracts
# Get from MetaMask or your wallet
# WARNING: Keep this secret! Never share or commit!
PRIVATE_KEY=0x...

# ==========================================
# REQUIRED FOR FRONTEND
# ==========================================

# WalletConnect Project ID
# Get from: https://cloud.walletconnect.com/
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=your_project_id_here

# ==========================================
# OPTIONAL BUT RECOMMENDED
# ==========================================

# Arbiscan API Key for contract verification
# Get from: https://arbiscan.io/apis
ARBISCAN_API_KEY=your_arbiscan_api_key

# Alchemy API Key for better RPC
# Get from: https://alchemy.com/
ALCHEMY_API_KEY=your_alchemy_key

# Infura API Key (alternative to Alchemy)
# Get from: https://infura.io/
INFURA_API_KEY=your_infura_key

# Pimlico API Key for account abstraction
# Get from: https://dashboard.pimlico.io/
PIMLICO_API_KEY=your_pimlico_key

# ==========================================
# CONTRACT ADDRESSES (Fill after deployment)
# ==========================================

# Arbitrum Sepolia (Testnet)
SEPOLIA_PRIME_VAULT_ADDRESS=
SEPOLIA_SAFE_FACTORY_ADDRESS=
SEPOLIA_RISK_MANAGER_ADDRESS=

# Arbitrum One (Mainnet)
MAINNET_PRIME_VAULT_ADDRESS=
MAINNET_SAFE_FACTORY_ADDRESS=
MAINNET_RISK_MANAGER_ADDRESS=

# ==========================================
# SAFE CONTRACT ADDRESSES (Arbitrum Sepolia - Chain ID: 421614)
# ==========================================
# Source: https://github.com/safe-global/safe-deployments (v1.4.1)
# These are the OFFICIAL Safe contract addresses deployed by Safe Global

# Safe Singleton (Master Copy) - The main Safe logic contract
# Used as delegate for all Safe proxies
SEPOLIA_SAFE_SINGLETON_ADDRESS=0x41675C099F32341bf84BFc5382aF534df5C7461a

# Safe Proxy Factory - Creates new Safe proxies
SEPOLIA_SAFE_PROXY_FACTORY_ADDRESS=0x4e1DCf7AD4e460CfD30791CCC4F9c8a4f820ec67

# Compatibility Fallback Handler - Handles ERC-721/1155 callbacks
SEPOLIA_FALLBACK_HANDLER_ADDRESS=0xfd0732Dc9E303f09fCEf3a7388Ad10A83459Ec99

# MultiSend - Batch multiple transactions into one
SEPOLIA_MULTI_SEND_ADDRESS=0x38869bf66a61cF6bDB996A6aE40D5853Fd43B526

# MultiSendCallOnly - Safe batch transactions (no delegate calls)
SEPOLIA_MULTI_SEND_CALL_ONLY_ADDRESS=0x9641d764fc13c8B624c04430C7356C1C7C8102e2

# ==========================================
# CHAINLINK PRICE FEEDS (Arbitrum Sepolia)
# ==========================================
# Get from: https://docs.chain.link/data-feeds/price-feeds/addresses

SEPOLIA_ETH_USD_FEED=0xd30e2101a97dcbAeBCBC04F14C3f624E67A87965
SEPOLIA_USDC_USD_FEED=0x...
SEPOLIA_WBTC_USD_FEED=0x...

# ==========================================
# APPLICATION SETTINGS
# ==========================================

# Default network (sepolia or mainnet)
DEFAULT_NETWORK=sepolia

# Enable debug logging
DEBUG=false

# API URL for backend (if applicable)
API_URL=http://localhost:3001
