{
  "name": "prime-vault",
  "version": "1.0.0",
  "description": "Institutional DeFi Prime Brokerage on Arbitrum",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network arbitrumSepolia",
    "deploy:mainnet": "hardhat run scripts/deploy.js --network arbitrumOne",
    "stylus:build": "cd contracts/stylus && cargo stylus check",
    "stylus:deploy": "cd contracts/stylus && cargo stylus deploy --endpoint https://sepolia-rollup.arbitrum.io/rpc --private-key $PRIVATE_KEY",
    "frontend:dev": "cd frontend && npm run dev",
    "frontend:build": "cd frontend && npm run build"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.0",
    "hardhat": "^2.19.0",
    "dotenv": "^16.3.0"
  },
  "dependencies": {
    "@safe-global/protocol-kit": "^3.0.0",
    "@safe-global/api-kit": "^2.0.0",
    "permissionless": "^0.1.0",
    "viem": "^2.0.0"
  }
}
